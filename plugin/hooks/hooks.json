{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/acm.js\" hook --event SessionStart",
            "timeout": 10,
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/acm.js\" hook --event UserPromptSubmit",
            "timeout": 10,
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/acm.js\" hook --event PostToolUse",
            "timeout": 10,
            "additionalContextLimit": 12000
          }
        ]
      }
    ]
  }
}
